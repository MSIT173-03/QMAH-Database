<Application x:Class="NpmDataWorkbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NavyBrush" Color="#193642" />
        <SolidColorBrush x:Key="InkBrush" Color="#24323D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#60707C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1F6F8B" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#E4F2F5" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D4DEE4" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,8,3" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,3,4,3" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Resources>
</Application>
