<Window x:Class="QmahTestDataWorkbench.CredentialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="展示帳密設定｜QMAH"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        FontFamily="Microsoft JhengHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="展示帳密設定" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" />
            <TextBlock Text="由版本庫範本建立本機帳密檔，逐筆填入測試密碼；密碼只會寫入本機檔與本機備份，不會修改版本庫範本。"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="本機儲存檔" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" x:Name="TargetPathBox" />
            <Button Grid.Column="2" Content="選擇位置" Click="ChoosePathButton_Click" />
        </Grid>

        <DataGrid Grid.Row="2"
                  x:Name="CredentialGrid"
                  IsReadOnly="False"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="顯示名稱" Binding="{Binding DisplayName}" IsReadOnly="True" Width="190" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" IsReadOnly="True" Width="230" />
                <DataGridTextColumn Header="角色" Binding="{Binding Role}" IsReadOnly="True" Width="100" />
                <DataGridTemplateColumn Header="測試密碼" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <PasswordBox PasswordChanged="CredentialPasswordBox_PasswordChanged"
                                         Loaded="CredentialPasswordBox_Loaded"
                                         DataContextChanged="CredentialPasswordBox_DataContextChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="載入版本庫範本" Click="LoadTemplateButton_Click" />
                <Button Content="讀取現有檔" Click="LoadFileButton_Click" />
                <Button Content="儲存帳密檔"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        Click="SaveButton_Click" />
                <Button Content="取消" Click="CancelButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
